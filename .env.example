# ASH environment. Copy to .env.local. None of these values are secret in this file.
# Never put a Zcash spending key, seed phrase, or viewing key here.

# Modes the app offers, and the mode new visitors start in.
# practice: labeled practice payments. testnet/mainnet: real payments verified on chain.
ASH_MODES=practice,testnet,mainnet
ASH_DEFAULT_MODE=practice

# lightwalletd endpoints used to read the chain. Defaults shown.
ASH_LIGHTWALLETD_TESTNET=https://testnet.zec.rocks:443
ASH_LIGHTWALLETD_MAINNET=https://zec.rocks:443

# Confirmations before a real payment counts.
ASH_CONFIRMATIONS_TESTNET=1
ASH_CONFIRMATIONS_MAINNET=3

# Seals the viewing keys people add under Receiving keys. 32+ random characters.
# Changing it makes stored keys unreadable, and people must add them again.
VIEWING_KEY_SECRET=

# Required in any shared or production deployment. 32+ random characters each.
# If unset, ASH uses documented insecure development keys and says so in /api/ash/health.
SESSION_SECRET=
RECEIPT_SIGNING_SECRET=

# Postgres connection for Vercel or any multi-instance host.
# If unset outside Vercel, ASH uses a single-process JSON file at .data/ash.json.
# On Vercel, DATABASE_URL is required. Serverless instances have no durable disk.
DATABASE_URL=

# Optional override for the local JSON store.
ASH_DATA_PATH=.data/ash.json
