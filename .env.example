# ASH environment. Copy to .env.local. None of these values are secret in this file.
# Never put a Zcash spending key, seed phrase, or viewing key here.

# testnet (default) or mainnet. The demo is testnet-shaped even when payments are simulated.
ASH_ZCASH_NETWORK=testnet

# simulated (default) or chain.
# simulated: practice payments. The adapter records a labeled payment and does not broadcast.
# chain: wallet payments. People pay from their wallet and paste the transaction id.
#        ASH asks ZCASH_RPC_URL whether it exists. Existence is not amount verification,
#        so an observed payment never unlocks a file, receipt, renewal, or paid note.
ASH_PAYMENT_MODE=simulated

# zcashd-compatible JSON-RPC that supports getrawtransaction. Leave empty if you have no node.
# Example: http://127.0.0.1:18232
ZCASH_RPC_URL=

# Optional HTTP basic auth for that node. Prefer a read-only RPC user.
ZCASH_RPC_USER=
ZCASH_RPC_PASSWORD=

# Confirmations required before a chain observation could ever count as confirmed.
# This build never treats observation alone as a satisfied payment.
ASH_REQUIRED_CONFIRMATIONS=3

# Shielded address shown on x402 challenges.
# Testnet default: an unfunded structural fixture, not a live recipient.
# Mainnet: required. Use a zs1... or u1... address you control. There is no default.
ASH_PAY_TO=

# Required in any shared or production deployment. 32+ random characters each.
# If unset, ASH uses documented insecure development keys and says so in /api/ash/health.
SESSION_SECRET=
RECEIPT_SIGNING_SECRET=

# Postgres connection for Vercel or any multi-instance host.
# If unset outside Vercel, ASH uses a single-process JSON file at .data/ash.json.
# On Vercel, DATABASE_URL is required. Serverless instances have no durable disk.
DATABASE_URL=

# Optional override for the local JSON store.
ASH_DATA_PATH=.data/ash.json
